---
---

<button
  id="theme-toggle"
  class="w-8 h-8 flex items-center justify-center hover:bg-[var(--fg)] hover:text-[var(--surface)] transition-colors"
  aria-label="Toggle theme"
>
  <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
  <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2"/>
    <path d="M12 20v2"/>
    <path d="m4.93 4.93 1.41 1.41"/>
    <path d="m17.66 17.66 1.41 1.41"/>
    <path d="M2 12h2"/>
    <path d="M20 12h2"/>
    <path d="m6.34 17.66-1.41 1.41"/>
    <path d="m19.07 4.93-1.41 1.41"/>
  </svg>
</button>

<script>
  const button = document.getElementById("theme-toggle");
  const iconMoon = document.getElementById("icon-moon");
  const iconSun = document.getElementById("icon-sun");

  function getTheme(): "light" | "dark" {
    return localStorage.getItem("theme") as "light" | "dark" || "light";
  }

  function updateIcons(theme: "light" | "dark") {
    if (theme === "light") {
      iconMoon?.style.setProperty("display", "block");
      iconSun?.style.setProperty("display", "none");
    } else {
      iconMoon?.style.setProperty("display", "none");
      iconSun?.style.setProperty("display", "block");
    }
  }

  function applyTheme(theme: "light" | "dark") {
    const root = document.documentElement;
    if (theme === "dark") {
      root.classList.add("dark");
      root.style.setProperty("--bg", "#0a0a0a");
      root.style.setProperty("--surface", "#141414");
      root.style.setProperty("--fg", "#f5f5f5");
      root.style.setProperty("--muted", "#888888");
      root.style.setProperty("--border", "#333333");
      root.style.setProperty("--color-grid", "#222222");
    } else {
      root.classList.remove("dark");
      root.style.setProperty("--bg", "#f8f7f4");
      root.style.setProperty("--surface", "#ffffff");
      root.style.setProperty("--fg", "#0a0a0a");
      root.style.setProperty("--muted", "#666666");
      root.style.setProperty("--border", "#e5e5e5");
      root.style.setProperty("--color-grid", "#e0ddd8");
    }
    localStorage.setItem("theme", theme);
    updateIcons(theme);
  }

  updateIcons(getTheme());

  button?.addEventListener("click", () => {
    const current = getTheme();
    applyTheme(current === "light" ? "dark" : "light");
  });
</script>
