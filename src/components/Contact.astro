---
interface Social {
  name: string;
  url: string;
  handle: string;
}

interface Props {
  email: string;
  cta: string;
  socials: Social[];
}

const { email, cta, socials } = Astro.props;
const currentYear = new Date().getFullYear();

const iconMap: Record<string, string> = {
  GitHub: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github-icon lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
  LinkedIn: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin-icon lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`,
};
---

<section id="contact" class="relative py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-12 gap-6 lg:gap-8">
      <div class="col-span-12 lg:col-span-4">
        <div class="animate-in lg:sticky lg:top-24">
          <h2 class="font-display font-bold text-5xl lg:text-6xl leading-none mb-4">
            Let's<br />Talk
          </h2>
          <p class="text-muted max-w-xs">
            Always happy to meet new people. Want to chat? Let's connect.
          </p>
        </div>
      </div>

      <div class="col-span-12 lg:col-span-8">
        <div class="grid sm:grid-cols-2 gap-0 border-hard">
          <a
            href={`mailto:${email}`}
            class="group p-8 surface border-r border-b sm:border-b-0 border-hard card-interactive"
          >
            <div class="flex items-start justify-between mb-8">
              <div class="w-12 h-12 border-hard-2 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted group-hover:text-[var(--accent)] transition-colors">
                <path d="M7 7h10v10"/>
                <path d="M7 17 17 7"/>
              </svg>
            </div>
            <div class="label mb-2">Email</div>
            <div class="font-mono text-lg group-hover:text-[var(--accent)] transition-colors">
              {email}
            </div>
          </a>

          {socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group p-8 surface border-hard card-interactive"
            >
              <div class="flex items-start justify-between mb-8">
                <div class="w-12 h-12 border-hard-2 flex items-center justify-center" set:html={iconMap[social.name] || iconMap["GitHub"]} />
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted group-hover:text-[var(--accent)] transition-colors">
                  <path d="M7 7h10v10"/>
                  <path d="M7 17 17 7"/>
                </svg>
              </div>
              <div class="label mb-2">{social.name}</div>
              <div class="font-mono text-lg group-hover:text-[var(--accent)] transition-colors">
                {social.handle}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <footer class="mt-32 border-hard surface px-6 py-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
        <div class="font-mono text-xs text-muted">
          © {currentYear} Paul Recker
        </div>
      </div>
    </footer>
  </div>
</section>
