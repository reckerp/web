---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  url: string;
  ogImage?: string;
}

const { title, description, url, ogImage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  const stored = localStorage.getItem("theme") as "light" | "dark" | null;
  const initial = stored || "light";
  
  function applyTheme(theme: "light" | "dark") {
    const root = document.documentElement;
    if (theme === "dark") {
      root.classList.add("dark");
      root.style.setProperty("--bg", "#0a0a0a");
      root.style.setProperty("--surface", "#141414");
      root.style.setProperty("--fg", "#f5f5f5");
      root.style.setProperty("--muted", "#888888");
      root.style.setProperty("--border", "#333333");
      root.style.setProperty("--color-grid", "#222222");
    } else {
      root.classList.remove("dark");
      root.style.setProperty("--bg", "#f8f7f4");
      root.style.setProperty("--surface", "#ffffff");
      root.style.setProperty("--fg", "#0a0a0a");
      root.style.setProperty("--muted", "#666666");
      root.style.setProperty("--border", "#e5e5e5");
      root.style.setProperty("--color-grid", "#e0ddd8");
    }
    localStorage.setItem("theme", theme);
  }
  
  applyTheme(initial);
</script>
