---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import Contact from "../components/Contact.astro";
import portfolio from "../data/portfolio.json";
---

<Layout 
  title="Paul Recker — Software Engineer"
  description="Computer Science student and software engineer building developer tools. Currently crafting observability solutions."
  url="https://recker.io"
  ogImage="/og.png"
>
  <Nav />
  
  <main>
    <Hero
      status={portfolio.hero.status}
      bio={portfolio.hero.bio}
      email={portfolio.contact.email}
      cta={portfolio.contact.cta}
    />
    
    <Work entries={portfolio.work} />
    
    <Contact
      email={portfolio.contact.email}
      cta={portfolio.contact.cta}
      socials={portfolio.contact.socials}
    />
  </main>
</Layout>
