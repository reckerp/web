---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getReadingTime } from "../../content/config";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body || "");

const formatDate = (date: Date) => {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
};

const allPosts = (await getCollection("blog", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const prevPost = allPosts[currentIndex + 1];
const nextPost = allPosts[currentIndex - 1];
---

<Layout
	title={`${post.data.title} — Paul Recker`}
	description={post.data.description}
	url={`https://recker.io/blog/${post.slug}`}
	ogImage={post.data.heroImage || "/og.png"}
>
	<main class="pt-32 pb-24">
		<article>
			<header class="max-w-7xl mx-auto px-6 lg:px-12 mb-16 animate-in">
				<div class="grid grid-cols-12 gap-6 lg:gap-8">
					<div class="col-span-12 lg:col-span-8 lg:col-start-3">
						<div class="flex flex-wrap items-center gap-4 mb-6">
							<a 
								href="/blog" 
								class="inline-flex items-center gap-2 font-mono text-xs tracking-widest uppercase text-muted hover:text-[var(--accent)] transition-colors"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="m15 18-6-6 6-6"/>
								</svg>
								All Posts
							</a>
							<span class="w-1 h-1 rounded-full bg-[var(--muted)]"></span>
							<time class="font-mono text-xs tracking-widest uppercase text-muted">
								{formatDate(post.data.pubDate)}
							</time>
							<span class="w-1 h-1 rounded-full bg-[var(--muted)]"></span>
							<span class="font-mono text-xs tracking-widest uppercase text-muted">
								{readingTime} min read
							</span>
						</div>

						<h1 class="font-display font-bold text-4xl lg:text-6xl leading-[0.9] tracking-tight mb-6">
							{post.data.title}
						</h1>

						<p class="text-xl text-muted leading-relaxed">
							{post.data.description}
						</p>

						{post.data.tags && (
							<div class="flex flex-wrap gap-2 mt-6">
								{post.data.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)}
					</div>
				</div>
			</header>

			{post.data.heroImage && (
				<div class="max-w-7xl mx-auto px-6 lg:px-12 mb-16 animate-in delay-1">
					<div class="border-hard-2 p-2">
						<img 
							src={post.data.heroImage} 
							alt={post.data.title}
							class="w-full h-auto"
						/>
					</div>
				</div>
			)}

			<div class="max-w-4xl mx-auto px-6 lg:px-12 relative z-10">
					<div class="surface border-hard p-6 lg:p-10">
						<div class="prose prose-lg max-w-none
							prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight
							prose-h1:text-2xl prose-h2:text-xl prose-h3:text-lg
							prose-p:text-[var(--fg)] prose-p:leading-relaxed prose-p:mb-6
							prose-a:text-[var(--accent)] prose-a:no-underline hover:prose-a:underline
							prose-code:font-mono prose-code:text-sm prose-code:bg-[var(--bg)] prose-code:px-1.5 prose-code:py-0.5 prose-code:border prose-code:border-[var(--border)] prose-code:before:content-none prose-code:after:content-none
							prose-pre:border-hard prose-pre:rounded-none prose-pre:text-[var(--fg)] prose-pre:p-4 prose-pre:my-6 prose-pre:overflow-x-auto prose-pre:leading-relaxed
							prose-pre code:bg-transparent prose-pre code:border-0 prose-pre code:p-0 prose-pre code:text-inherit
							prose-blockquote:border-l-2 prose-blockquote:border-[var(--accent)] prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-[var(--fg)] prose-blockquote:my-6
							prose-ul:text-[var(--fg)] prose-ol:text-[var(--fg)] prose-li:text-[var(--fg)] prose-li:mb-2
							prose-strong:text-[var(--fg)]
							prose-img:border-hard prose-img:my-6
							prose-hr:border-[var(--border)] prose-hr:my-8
						">
							<Content />
						</div>
					</div>
				</div>
		</article>

		<nav class="max-w-7xl mx-auto px-6 lg:px-12 mt-20 pt-10 border-t border-[var(--border)]">
			<div class="grid grid-cols-12 gap-6">
				{prevPost ? (
					<div class="col-span-12 sm:col-span-6 animate-in">
						<a href={`/blog/${prevPost.slug}`} class="group block">
							<span class="font-mono text-xs tracking-widest uppercase text-muted block mb-2">Previous</span>
							<span class="font-display font-bold text-lg group-hover:text-[var(--accent)] transition-colors">
								← {prevPost.data.title}
							</span>
						</a>
					</div>
				) : (
					<div class="col-span-6"></div>
				)}
				
				{nextPost ? (
					<div class="col-span-12 sm:col-span-6 sm:text-right animate-in">
						<a href={`/blog/${nextPost.slug}`} class="group block">
							<span class="font-mono text-xs tracking-widest uppercase text-muted block mb-2">Next</span>
							<span class="font-display font-bold text-lg group-hover:text-[var(--accent)] transition-colors">
								{nextPost.data.title} →
							</span>
						</a>
					</div>
				) : (
					<div class="col-span-6"></div>
				)}
			</div>
		</nav>
	</main>
</Layout>
